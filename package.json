{
  "name": "discord-bouyomi-bot",
  "version": "1.0.0",
  "buildInfo": {
    "date": "20261126",
    "seed": "6724",
    "build": 1,
    "arch": "64"
  },
  "description": "Discordのテキストを棒読みちゃんに読み上げさせるBot(GUI版)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable && node scripts/copy-exe.js",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "discord.js": "^14.16.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.discord-bouyomi-bot",
    "productName": "DiscordBouyomiBot",
    "files": [
      "main.js",
      "preload.js",
      "bot-core.js",
      "bouyomi-launcher.js",
      "updater.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DiscordBouyomiBot.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord 棒読みちゃんBot",
      "language": "1041",
      "artifactName": "DiscordBouyomiBot-Setup.exe"
    }
  }
}